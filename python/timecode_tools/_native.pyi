# Types of the native module (src/lib.rs). Internal; see the package for the API.

NativeTimecode = tuple[
    int, int, int, int, bool, str | None, bool, float | None, int | None, int | None
]  # hours, minutes, seconds, frames, drop_frame, frame_rate, locked, timestamp, sample_index, channel
NativeEvent = tuple[str, NativeTimecode | None, int | None]  # kind, timecode, previous
NativeLabel = tuple[int, int, int, int, bool]

class NativeLtcDecoder:
    def __init__(
        self, sample_rate: int, channels: int, channel: int, frame_rate: str | None, offset_frames: int
    ) -> None: ...
    def push(self, data: bytes, float: bool, timestamp: float | None = None) -> list[NativeTimecode]: ...
    @property
    def locked(self) -> bool: ...
    @property
    def frame_rate(self) -> str | None: ...
    @property
    def signal_level(self) -> float: ...
    @property
    def samples_decoded(self) -> int: ...

class NativeLtcReceiver:
    def __init__(self, frame_rate: str | None, offset_frames: int, lost_after: float, channel: int) -> None: ...
    def push(
        self, data: bytes, float: bool, sample_rate: int, channels: int, timestamp: float
    ) -> list[NativeEvent]: ...
    def signal_lost(self) -> list[NativeEvent]: ...
    @property
    def locked(self) -> bool: ...
    @property
    def detected_rate(self) -> str | None: ...
    @property
    def level(self) -> float: ...
    offset_frames: int
    def frames_at(self, timestamp: float) -> float | None: ...

class NativeMtcReceiver:
    def __init__(self, frame_rate: str | None, offset_frames: int, lost_after: float) -> None: ...
    def push(self, data: bytes, timestamp: float) -> list[NativeEvent]: ...
    def signal_lost(self) -> list[NativeEvent]: ...
    @property
    def locked(self) -> bool: ...
    @property
    def detected_rate(self) -> str | None: ...
    offset_frames: int
    def frames_at(self, timestamp: float) -> float | None: ...

def frame_index(label: NativeLabel, fps: int) -> int: ...
def label_from_index(index: int, fps: int, drop_frame: bool) -> NativeLabel: ...
def frames_per_day(fps: int, drop_frame: bool) -> int: ...
def generate_ltc(sample_rate: int, frame_rate: str, start_index: int, frame_count: int, amplitude: float) -> bytes: ...
def generate_mtc(frame_rate: str, start_index: int, frame_count: int) -> tuple[bytes, list[float]]: ...
def mtc_full_frame(frame_rate: str, label: NativeLabel) -> bytes: ...
